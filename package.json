{
  "name": "audis-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "Audis by Neura Audis. Windows audio intelligence. Hear more. Understand faster.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @audis/desktop dev",
    "build": "pnpm --filter @audis/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "tauri": "pnpm --filter @audis/desktop tauri"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
