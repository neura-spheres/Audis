{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audis",
  "version": "0.1.3",
  "identifier": "ai.neura.audis",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Neura Audis",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "captions",
        "title": "Audis Captions",
        "url": "index.html?window=captions",
        "width": 900,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "controller",
        "title": "Audis Controller",
        "url": "index.html?window=controller",
        "width": 300,
        "height": 68,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "assistant",
        "title": "Audis Assistant",
        "url": "index.html?window=assistant",
        "width": 380,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Neura Audis",
    "copyright": "\u00a9 2026 Neura Audis",
    "category": "Productivity",
    "shortDescription": "Hear more. Understand faster.",
    "longDescription": "Audis captures your microphone and your computer's audio as separate sources, transcribes them live, and helps you understand the conversation.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1QkJDNjAxQkY4OThEMTEKUldRUmpZbS9BY2E3bGFZbDJYSjdVVlVMWWg0ajFHU2hKVXgzeVc3VFZkekFXRXZGK0krajhsSEYK",
      "endpoints": ["https://github.com/neura-spheres/Audis/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
